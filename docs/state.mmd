stateDiagram-v2
  [*] --> DRAFT: створення лоту
  state "Чернетка" as DRAFT
  state "На модерації" as ON_MODERATION
  state "Відхилено" as REJECTED
  state "Активні торги" as ACTIVE
  state "Завершено з переможцем" as FINISHED_WITH_WINNER
  state "Завершено без переможця" as FINISHED_WITHOUT_WINNER
  state "Знято" as WITHDRAWN

  DRAFT --> ON_MODERATION: подання на перевірку
  ON_MODERATION --> ACTIVE: схвалення модератором
  ON_MODERATION --> REJECTED: відхилення модератором
  REJECTED --> ON_MODERATION: повторне подання продавцем
  DRAFT --> WITHDRAWN: зняття продавцем
  ON_MODERATION --> WITHDRAWN: зняття продавцем
  REJECTED --> WITHDRAWN: зняття продавцем
  ACTIVE --> ACTIVE: прийняти ставку [в межах часу і ≥ поточна ціна + minimumIncrement]
  ACTIVE --> FINISHED_WITH_WINNER: завершення часу [є прийняті ставки]
  ACTIVE --> FINISHED_WITHOUT_WINNER: завершення часу [ставок немає]
  WITHDRAWN --> [*]: завершення знятого лоту
  FINISHED_WITH_WINNER --> [*]: фінальний результат
  FINISHED_WITHOUT_WINNER --> [*]: фінальний результат
