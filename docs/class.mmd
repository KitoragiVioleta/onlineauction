classDiagram
class AuctionParticipant {
  <<abstract>>
  -String participantId
  -String displayName
  +AuctionParticipant(String participantId, String displayName)
  +abstract String getRole()
  +final String getDisplayName()
}

class Seller {
  -List~Lot~ lots
  +Seller(String participantId, String displayName)
  +override String getRole()
  +override boolean canPerform(Lot lot)
  +Lot createLot(String description, BigDecimal startingPrice)
  +void submitForModeration(Auction auction)
  +void withdraw(Auction auction)
}

class Bidder {
  -List~Bid~ submittedBids
  +Bidder(String participantId, String displayName)
  +override String getRole()
  +override boolean canPerform(Lot lot)
  +List~Bid~ getSubmittedBids()
}

class Moderator {
  -List~Auction~ reviewedAuctions
  +Moderator(String participantId, String displayName)
  +override String getRole()
  +override boolean canPerform(Lot lot)
  +void approve(Auction auction)
  +void reject(Auction auction)
}

class ITradingRules {
  <<interface>>
  +boolean canPerform(Lot lot)
}

class IAcquiringService {
  <<interface>>
  +void charge(Bidder bidder, BigDecimal amount)
}

class AuctionStatus {
  <<enumeration>>
  -String label
  +AuctionStatus(String label)
  +String getLabel()
  DRAFT
  ON_MODERATION
  REJECTED
  ACTIVE
  FINISHED_WITH_WINNER
  FINISHED_WITHOUT_WINNER
  WITHDRAWN
}

class Auction {
  -String auctionId
  -AuctionStatus status
  -LocalDateTime startTime
  -LocalDateTime endTime
  -BigDecimal minimumIncrement
  -Lot lot
  -BigDecimal finalPrice
  -Bidder winner
  -IAcquiringService acquiringService
  +Auction(String auctionId, Lot lot, LocalDateTime startTime, LocalDateTime endTime, BigDecimal minimumIncrement, IAcquiringService acquiringService)
  +void submitForModeration()
  +void approve()
  +void reject()
  +void withdraw()
  +boolean placeBid(Bidder bidder, BigDecimal amount)
  +boolean placeBid(Bidder bidder, BigDecimal amount, LocalDateTime submittedAt)
  +void close()
  +Bidder determineWinner()
}

class Lot {
  -String lotId
  -String description
  -BigDecimal startingPrice
  -List~Bid~ bids
  +Lot(String lotId, String description, BigDecimal startingPrice)
  +Bid addBid(BigDecimal amount, LocalDateTime submittedAt, Bidder bidder)
  +Bid getHighestBid()
  +List~Bid~ getBids()
}

class Bid {
  -BigDecimal amount
  -LocalDateTime submittedAt
  -Bidder bidder
  +Bid(BigDecimal amount, LocalDateTime submittedAt, Bidder bidder)
  +BigDecimal getAmount()
  +LocalDateTime getSubmittedAt()
  +Bidder getBidder()
}

class AcquiringService {
  -String merchantId
  +AcquiringService(String merchantId)
  +void charge(Bidder bidder, BigDecimal amount)
}

AuctionParticipant <|-- Seller
AuctionParticipant <|-- Bidder
AuctionParticipant <|-- Moderator
Seller ..|> ITradingRules
Bidder ..|> ITradingRules
Moderator ..|> ITradingRules
AcquiringService ..|> IAcquiringService
Auction "1" --> "1" Lot : manages
Lot "1" *-- "0..*" Bid : contains
Bidder "1" -- "0..*" Bid : submits
Auction --> "0..1" Bidder : winner
Seller "1" --> "0..*" Lot : creates
Moderator "1" --> "0..*" Auction : reviews
Auction ..> IAcquiringService : charges through
Auction --> AuctionStatus : status
