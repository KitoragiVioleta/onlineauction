@startuml
left to right direction
skinparam packageStyle rectangle

actor "Продавець" as Seller
actor "Учасник торгів" as Bidder
actor "Модератор" as Moderator

rectangle "Онлайн-аукціон" {
  usecase "Виставити лот\n(опис, стартова ціна)" as UC_CreateLot
  usecase "Зняти лот" as UC_WithdrawLot
  usecase "Перевірити лот" as UC_ReviewLot
  usecase "Повторно подати\nвідхилений лот" as UC_ResubmitLot
  usecase "Подати ставку\nу межах часу торгів" as UC_PlaceBid
  usecase "Визначити переможця" as UC_DetermineWinner
  usecase "Зафіксувати підсумкову ціну" as UC_FinalPrice
  usecase "Симулювати оплату" as UC_Charge
}

Seller --> UC_CreateLot
Seller --> UC_WithdrawLot
Seller --> UC_ResubmitLot
Moderator --> UC_ReviewLot
Bidder --> UC_PlaceBid

UC_DetermineWinner ..> UC_FinalPrice : <<include>>
UC_DetermineWinner ..> UC_Charge : <<include>>
UC_DetermineWinner --> Seller : повідомлення про результат
UC_DetermineWinner --> Bidder : повідомлення про результат
note bottom of UC_DetermineWinner
  Ініціює система після завершення часу торгів
end note
@enduml
